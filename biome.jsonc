{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  // The engine declarations under plugins/types are generated by /plugin-types, not written here.
  "files": { "includes": ["**", "!plugins/types"] },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // Same style as the maintainer's other TypeScript projects: 2-space indent, single quotes,
  // semicolons, trailing commas, lines up to 120.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // tsconfig sets noUncheckedIndexedAccess, which makes `xs[0]!` the normal way to use an index
        // already proven present. Banning it means dropping that flag or adding a redundant runtime
        // check at every access.
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // A hook is always `($, e, next)`, positional, whether or not it reads `$` or `e`: the engine
      // hands the arguments in that order, so the rule's underscore renames would only add noise.
      "includes": ["plugins/*/hooks/register.ts", "plugins/*/tests/**"],
      "linter": { "rules": { "correctness": { "noUnusedFunctionParameters": "off" } } }
    }
  ]
}
