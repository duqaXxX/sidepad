{
  // Repository tooling only: these scripts run under Bun. The mod gets its own tsconfig, started
  // from the official mods/tsconfig.json, whose `types: []` is right for code the engine runs and
  // wrong for code that imports node:child_process.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  // The plugin's declarations come with it: a tooling test importing a hooks module reaches the
  // ambient `claude-code` the module's own imports name.
  "include": [".", "../../plugins/types"]
}
