# No trailing slash: with one, the pattern matches a directory only, and a `node_modules` that is a
# symlink to a shared store is then tracked as a file holding an absolute path.
node_modules
dist
*.log
.DS_Store
.superpowers/

# What `/plugin-types` writes for whoever runs it: the declarations of their own build, and beside
# them the lists of their MCP servers and installed plugins. The engine declarations this repo
# builds against are committed at plugins/types/ instead.
.claude/types/
.claude/settings.local.json

# Never a real environment file. An example one is documentation and stays.
.env
.env.*
!.env.example
